{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joselunasrt8-creator/SYNAPSE/schemas/artifact.schema.json",
  "title": "SYNAPSE Canonical Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "artifact_type", "version", "producer", "inputs", "outputs", "provenance", "content_hash", "lifecycle_state", "validity", "supersession", "relationships", "payload"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/artifactId"},
    "artifact_type": {"$ref": "#/$defs/artifactType"},
    "version": {"type": "integer", "minimum": 1},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "outputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "lifecycle_state": {"enum": ["draft", "active", "superseded", "deprecated", "withdrawn"]},
    "validity": {"$ref": "#/$defs/validity"},
    "supersession": {"$ref": "#/$defs/supersession"},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"lifecycle_state": {"const": "superseded"}}, "required": ["lifecycle_state"]}, "then": {"properties": {"supersession": {"required": ["superseded_by"]}}}}
  ],
  "$defs": {
    "artifactId": {"type": "string", "pattern": "^artifact:(repository_snapshot|observation|evidence_record|model_object|analysis_result|decision_reference|validation_record|authorization_record|execution_record):[a-z][a-z0-9-]*$"},
    "artifactType": {"enum": ["repository_snapshot", "observation", "evidence_record", "model_object", "analysis_result", "decision_reference", "validation_record", "authorization_record", "execution_record"]},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_type", "version", "content_hash"], "properties": {"artifact_id": {"$ref": "#/$defs/artifactId"}, "artifact_type": {"$ref": "#/$defs/artifactType"}, "version": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/hash"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["id", "kind"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["human", "software", "organization"]}, "version": {"type": "string", "minLength": 1}}, "allOf": [{"if": {"properties": {"kind": {"const": "software"}}, "required": ["kind"]}, "then": {"required": ["version"]}}]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["origin", "method", "parameters", "environment", "produced_at"], "properties": {"origin": {"type": "object", "additionalProperties": false, "required": ["locator", "revision"], "properties": {"locator": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}}}, "method": {"type": "string", "minLength": 1}, "parameters": {"type": "object"}, "environment": {"type": "object"}, "produced_at": {"type": "string", "format": "date-time"}}},
    "validity": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "confidence", "basis"],
      "properties": {
        "state": {"enum": ["unassessed", "valid", "invalid", "indeterminate"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "string"},
        "assessed_by": {"$ref": "#/$defs/reference"},
        "assessed_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "unassessed"}}, "required": ["state"]},
          "then": {
            "properties": {"confidence": {"const": 0}, "basis": {"const": ""}},
            "not": {"anyOf": [{"required": ["assessed_by"]}, {"required": ["assessed_at"]}]}
          }
        },
        {
          "if": {"properties": {"state": {"enum": ["valid", "invalid", "indeterminate"]}}, "required": ["state"]},
          "then": {"required": ["assessed_by", "assessed_at"], "properties": {"basis": {"minLength": 1}}}
        }
      ]
    },
    "supersession": {"type": "object", "additionalProperties": false, "properties": {"previous": {"$ref": "#/$defs/reference"}, "superseded_by": {"$ref": "#/$defs/reference"}}},
    "relationship": {"type": "object", "additionalProperties": false, "required": ["assertion_id", "type", "target", "rationale"], "properties": {"assertion_id": {"type": "string", "pattern": "^rel:[a-z][a-z0-9-]*$"}, "type": {"enum": ["produced_by", "derived_from", "supports", "contradicts", "supersedes", "implements", "validated_by", "authorized_by", "executed_as"]}, "target": {"$ref": "#/$defs/reference"}, "rationale": {"type": "string", "minLength": 1}}, "allOf": [{"if": {"properties": {"type": {"const": "produced_by"}}, "required": ["type"]}, "then": {"properties": {"target": {"properties": {"artifact_type": {"const": "execution_record"}}}}}}, {"if": {"properties": {"type": {"const": "validated_by"}}, "required": ["type"]}, "then": {"properties": {"target": {"properties": {"artifact_type": {"const": "validation_record"}}}}}}, {"if": {"properties": {"type": {"const": "authorized_by"}}, "required": ["type"]}, "then": {"properties": {"target": {"properties": {"artifact_type": {"const": "authorization_record"}}}}}}, {"if": {"properties": {"type": {"const": "executed_as"}}, "required": ["type"]}, "then": {"properties": {"target": {"properties": {"artifact_type": {"const": "execution_record"}}}}}}]}
  }
}
